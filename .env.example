# AWS Configuration
AWS_REGION=
BEDROCK_MODEL_ID=

# DynamoDB Tables
LEADS_TABLE=leadrescue-leads
FOLLOWUPS_TABLE=leadrescue-followups
AUDIT_TABLE=leadrescue-audit
CONFIG_TABLE=leadrescue-config
PROCESSED_EVENTS_TABLE=leadrescue-processed-events
CUSTOMER_SUPPRESSIONS_TABLE=leadrescue-customer-suppressions
PRIVACY_REQUESTS_TABLE=leadrescue-privacy-requests
WEBHOOK_SECRET_ARN=

# Application Mode
DEMO_MODE=true
APP_ENV=local

# Required for non-demo API traffic (OIDC issuer, audience/client ID, company claim)
JWT_ISSUER=
JWT_JWKS_URL=
JWT_AUDIENCE=
JWT_REQUIRED_SCOPE=
TENANT_ID=
ADMIN_ROLE=company_admin
OPERATOR_ROLE=sales_operator
CORS_ORIGINS=http://localhost:3000
